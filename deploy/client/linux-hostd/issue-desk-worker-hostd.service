[Unit]
Description=issue-desk Workerのホスト更新周期
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/issue-desk/worker
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env -u GODEBUG %h/.local/share/issue-desk/worker/hostd/hostd --config %h/.local/share/issue-desk/worker/hostd/config.json --check
ExecStart=/usr/bin/env -u GODEBUG %h/.local/share/issue-desk/worker/hostd/hostd --config %h/.local/share/issue-desk/worker/hostd/config.json
TimeoutStartSec=30min
